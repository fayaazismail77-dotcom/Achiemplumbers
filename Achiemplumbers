.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--display);line-height:1.05;margin:0;letter-spacing:-.02em}

/* nav */
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:var(--marine);color:#fff}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.brand{font-family:var(--display);font-weight:800;font-size:22px;text-decoration:none;display:flex;align-items:center;gap:10px}
.brand i{width:26px;height:26px;border-radius:5px;background:var(--copper);display:grid;place-items:center}
.brand i::after{content:"";width:10px;height:10px;background:var(--marine);border-radius:2px}
nav a{color:#CFE0E6;text-decoration:none;margin-left:26px;font-weight:500;font-size:15px}
nav a:hover{color:#fff}
.btn{display:inline-block;background:var(--spark);color:#0C2B3A!important;font-weight:700;padding:14px 26px;border-radius:8px;text-decoration:none;font-size:16px;transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
nav .btn{padding:10px 18px;margin-left:26px;font-size:15px}
@media(max-width:760px){nav a:not(.btn){display:none}}

/* hero */
.hero{background:var(--marine);color:#fff;padding:72px 0 88px;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(42px,6.4vw,76px);font-weight:800}
.hero p{color:#BFD3DB;font-size:19px;max-width:30em;margin:24px 0 32px}
.hero .actions{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.ghost{color:#fff;font-weight:500;text-decoration:underline;text-underline-offset:5px}
.tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;aspect-ratio:1;max-width:460px;width:100%;margin-left:auto}
.tile{border-radius:8px;background:var(--marine-2);display:grid;place-items:center;opacity:0;animation:lay .5s ease-out forwards;animation-delay:calc(var(--i)*55ms + 150ms)}
.tile svg{width:46%;height:46%}
.t-water{background:var(--water)} .t-spark{background:var(--spark)} .t-clean{background:var(--copper)}
.tile.alt{background:#175069}
.tile.scene{grid-column:2/5;grid-row:3/5;background:none;overflow:hidden}
.tile.scene svg{width:100%;height:100%}
.fix-tile{animation:drop 4.5s ease-in-out infinite}
.fix-arm{transform-origin:208px 136px;animation:tap 4.5s ease-in-out infinite}
.fix-spark{transform-origin:288px 171px;opacity:0;animation:pop 4.5s ease-out infinite}
@keyframes drop{0%{transform:translateY(-100px);opacity:0}12%{opacity:1}40%{transform:translateY(0)}50%{transform:translateY(-4px)}56%,86%{transform:translateY(0);opacity:1}96%,100%{transform:translateY(0);opacity:0}}
@keyframes tap{0%,40%{transform:rotate(-18deg)}46%{transform:rotate(6deg)}52%{transform:rotate(-8deg)}58%{transform:rotate(6deg)}64%{transform:rotate(-8deg)}70%{transform:rotate(6deg)}78%,100%{transform:rotate(-18deg)}}
@keyframes pop{0%,44%{opacity:0;transform:scale(.2)}50%{opacity:1;transform:scale(1)}62%,100%{opacity:0;transform:scale(1.3)}}
@media(prefers-reduced-motion:reduce){.fix-tile,.fix-arm,.fix-spark{animation:none}}
@keyframes lay{from{opacity:0;transform:scale(.6)}to{opacity:1;transform:scale(1)}}
@media(prefers-reduced-motion:reduce){.tile{animation:none;opacity:1}html{scroll-behavior:auto}.btn{transition:none}}
@media(max-width:860px){.hero .wrap{grid-template-columns:1fr}.tiles{margin:0;max-width:360px}}

/* sections */
section{padding:88px 0}
.head{max-width:620px;margin-bottom:48px}
.head h2{font-size:clamp(32px,4.4vw,50px);font-weight:800}
.head p{color:var(--muted);margin:16px 0 0}

/* services */
.svc{display:grid;grid-template-columns:260px 1fr 1fr;gap:32px;align-items:start;padding:36px 0;border-top:2px solid var(--line)}
.svc:last-child{border-bottom:2px solid var(--line)}
.art{width:100%;height:auto;display:block;border-radius:14px}
.svc h3{font-size:32px;font-weight:700}
.svc p{margin:10px 0 0;color:var(--muted)}
.svc ul{margin:0;padding:0;list-style:none;display:grid;gap:10px}
.svc li{padding-left:26px;position:relative}
.svc li::before{content:"";position:absolute;left:0;top:.6em;width:12px;height:3px;background:var(--c)}
@media(max-width:820px){.svc{grid-template-columns:1fr;gap:18px}.art{max-width:320px}}

/* process */
.process{background:var(--marine);color:#fff}
.process .head p{color:#BFD3DB}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;counter-reset:s}
.step{padding:0 24px 0 0;border-top:3px solid var(--copper);padding-top:22px;counter-increment:s}
.step::before{content:counter(s);font-family:var(--display);font-weight:800;font-size:46px;color:var(--spark);display:block;line-height:1;margin-bottom:12px}
.step h3{font-size:22px;margin-bottom:8px}
.step p{margin:0;color:#BFD3DB;font-size:16px}
@media(max-width:860px){.steps{grid-template-columns:1fr 1fr;row-gap:36px}}
@media(max-width:520px){.steps{grid-template-columns:1fr}}

/* contact */
.contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.contact h2{font-size:clamp(34px,5vw,56px);font-weight:800}
.contact .lede{color:var(--muted);margin:18px 0 28px;max-width:28em}
.card{background:var(--panel);border:2px solid var(--line);border-radius:16px;padding:32px}
.card h3{font-size:20px;margin-bottom:6px}
.card address{font-style:normal;font-size:20px;line-height:1.5;margin-bottom:22px}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
.chip{border:2px solid var(--line);border-radius:999px;padding:7px 16px;font-weight:500;font-size:15px}
@media(max-width:820px){.contact .wrap{grid-template-columns:1fr}}

/* reviews */
.reviews{display:grid;grid-template-columns:1fr 1fr;gap:0 56px}
.rev{margin:0;padding:28px 0;border-top:2px solid var(--line)}
.rev p{margin:0 0 14px;font-size:19px;line-height:1.55}
.rev.long{grid-column:1/-1}
.rev.long p{font-size:17px;color:var(--muted);max-width:60em}
.rev cite{font-style:normal;font-weight:700;font-family:var(--display);font-size:17px}
.rev span{color:var(--muted);font-size:15px;margin-left:8px}
@media(max-width:820px){.reviews{grid-template-columns:1fr}}
footer{background:var(--marine);color:#9DB5BF;padding:32px 0;font-size:15px}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}

/* polish */
.hero{position:relative;padding:80px 0 130px;clip-path:polygon(0 0,100% 0,100% 90%,0 100%);background:radial-gradient(800px 480px at 88% 25%,#1D6283 0%,transparent 65%),var(--marine)}
.hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:64px 64px;pointer-events:none}
.hero .wrap{position:relative}
.hero h1{font-size:clamp(46px,7vw,88px)}
.tiles{filter:drop-shadow(0 24px 40px rgba(0,0,0,.35))}
