}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#081C27;--ink:#E8F0F2;--muted:#9DB5BF;--panel:#0F2E3D;--line:#1D4558}}
:root[data-theme="dark"]{--bg:#081C27;--ink:#E8F0F2;--muted:#9DB5BF;--panel:#0F2E3D;--line:#1D4558}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.6}
a{color:inherit}
