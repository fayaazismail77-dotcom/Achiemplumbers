#reviews{background:var(--panel)}
.rev:not(.long)::before{content:"\201C";display:block;font-family:var(--display);font-weight:800;font-size:72px;line-height:.7;color:var(--copper);margin-bottom:6px}
.contact{background:var(--spark);color:#0C2B3A}
.contact .lede{color:#2A4F5F}
.contact .btn{background:#0C2B3A;color:#fff!important}
.card{color:var(--ink);box-shadow:0 20px 40px rgba(12,43,58,.2);border-color:transparent}
.bigtel{display:block;font-family:var(--display);font-weight:800;font-size:clamp(34px,5vw,54px);letter-spacing:-.02em;margin:0 0 22px;text-decoration:none}
.callfab{display:none}
@media(max-width:760px){.msgfab{right:auto!important;left:16px}.callfab{display:block;position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:20;background:var(--copper);color:#0C2B3A;font-weight:700;padding:14px 22px;border-radius:999px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,.35)}}
@media(prefers-reduced-motion:reduce){.svc .art{transition:none}.svc:hover .art{transform:none}}

/* animated background */
.fx{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.f{position:absolute;aspect-ratio:1;animation-duration:var(--d,8s);animation-delay:var(--l,0s);animation-iteration-count:infinite;animation-timing-function:linear}
.drop{top:0;fill:var(--water);opacity:0;animation-name:fall}
.bolt{fill:var(--spark);opacity:0;animation-name:flick;animation-timing-function:steps(1,end)}
.twk{fill:var(--spark);opacity:.1;animation-name:twk;animation-timing-function:ease-in-out;animation-direction:alternate}
.sq{background:var(--copper);border-radius:6px;opacity:.18;animation-name:drift;animation-timing-function:ease-in-out;animation-direction:alternate}
@keyframes fall{0%{transform:translateY(-8vh);opacity:0}12%{opacity:.45}85%{opacity:.3}100%{transform:translateY(88vh);opacity:0}}
@keyframes flick{0%,100%{opacity:0}6%{opacity:.5}9%{opacity:.08}13%{opacity:.45}20%{opacity:0}}
@keyframes twk{from{transform:scale(.5);opacity:.08}to{transform:scale(1.1);opacity:.7}}
@keyframes drift{from{transform:translateY(0) rotate(0)}to{transform:translateY(-36px) rotate(24deg)}}
@media(prefers-reduced-motion:reduce){.fx{display:none}}

/* animated illustrations */
.fb{transform-box:fill-box;transform-origin:center}
.p-drop{animation:dfall 1.8s ease-in infinite}
.p-late{animation-delay:.9s}
.wrench{transform-origin:205px 125px;animation:wob 2.4s ease-in-out infinite alternate}
.e-bolt{animation:zap 2.2s ease-in-out infinite}
.e-glow{animation:glow 2.2s ease-in-out infinite}
.e-sparks{animation:sparks 1.4s steps(1,end) infinite}
.t-sp{animation:tw 2.4s ease-in-out infinite alternate}
.sponge{animation:swipe 3s ease-in-out infinite alternate}
@keyframes dfall{0%{transform:translateY(-8px);opacity:0}25%{opacity:1}100%{transform:translateY(26px);opacity:0}}
@keyframes wob{from{transform:rotate(-7deg)}to{transform:rotate(7deg)}}
@keyframes zap{0%,100%{transform:scale(1);opacity:1}45%{transform:scale(1.08);opacity:1}50%{opacity:.55}55%{transform:scale(1.12);opacity:1}}
@keyframes glow{0%,100%{transform:scale(.9);opacity:.2}50%{transform:scale(1.15);opacity:.45}}
@keyframes sparks{0%{opacity:1}30%{opacity:.15}60%{opacity:1}80%{opacity:0}}
@keyframes tw{from{transform:scale(.6);opacity:.5}to{transform:scale(1.2);opacity:1}}
@keyframes swipe{from{transform:translateX(-60px)}to{transform:translateX(60px)}}
@media(prefers-reduced-motion:reduce){.a{animation:none!important}}

/* animated worker */
.process{position:relative;overflow:hidden}
.process .wrap{position:relative;z-index:1}
.worker{position:absolute;top:44px;right:max(24px,calc((100% - 1120px)/2 + 24px));width:280px;height:auto}
.bob{animation:bob 1.2s ease-in-out infinite alternate}
.wrench2{transform-origin:210px 187px;animation:ratchet 1.2s ease-in-out infinite alternate}
@keyframes bob{from{transform:translateY(0)}to{transform:translateY(3px)}}
@keyframes ratchet{from{transform:rotate(-24deg)}to{transform:rotate(14deg)}}
@media(max-width:980px){.worker{position:relative;top:auto;right:auto;display:block;margin:0 auto 24px;width:min(260px,70%)}.process{padding-top:56px}}
</style>
